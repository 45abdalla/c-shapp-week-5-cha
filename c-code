namespace dauud_sseyment
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            double width=double.Parse(textBox1.Text);   
            double length= double.Parse(textBox2.Text);

            if (textBox1.Text == "" || textBox2.Text == "")
            {
                MessageBox.Show("Please enter all values");
            }
            else if (!double.TryParse(textBox1.Text, out width) ||
                     !double.TryParse(textBox2.Text, out length))
            {
                MessageBox.Show("Please enter valid numbers");
            }
            else if (width <= 0 || length <= 0)
            {
                MessageBox.Show("Width and Length must be greater than 0");
            }
            else
            {
                double Area = width * length;


                lblresult.Text = Area.ToString();
            }

        }
    }
}
